# ── FeelFit frontend environment ──────────────────────────────────────────────
# Copy to `.env.local` for local dev. For the mobile app, set these as build-time
# env vars in your CI (Codemagic, Bitrise, GitHub Actions) — they get baked into
# the static export via Next.js's NEXT_PUBLIC_* mechanism.
# This template was auto-sanitized from the production .env.local on ZIP packaging.

# URL of the deployed FastAPI backend (no trailing slash). MUST be HTTPS for
# production Capacitor builds (cleartext is disabled by default).
# Production: https://api.feelfit.app
# Local dev:  http://10.0.2.2:8000  (Android emulator → host loopback)
#             http://localhost:8000 (iOS simulator → host loopback)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Build target flag — set to "mobile" to enable Next.js static export mode.
# Leave unset for the normal web build.
BUILD_TARGET=mobile

# Google Sign-In OAuth 2.0 Client ID (Web). The Capacitor app uses the same
# Web client ID as the web app — Google Sign-In for Web works inside the WebView.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Firebase Phone Auth (optional). Web config values, NOT secrets. From your
# Firebase project (console.firebase.google.com) → Project settings → General →
# Your apps → Web app → SDK setup and configuration. FIREBASE_PROJECT_ID must
# match the backend's env var of the same name.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
