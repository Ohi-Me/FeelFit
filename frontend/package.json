{
  "name": "feelfit",
  "version": "10.0.0",
  "private": true,
  "description": "FeelFit — unified Next.js frontend for Web, Android (Capacitor) and iOS (Capacitor)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "cap:sync": "npm run build && node scripts/prepare-mobile.mjs && npx cap sync",
    "cap:sync:ios": "npm run build && node scripts/prepare-mobile.mjs && npx cap sync ios",
    "cap:sync:android": "npm run build && node scripts/prepare-mobile.mjs && npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "mobile:run:android": "npm run build && node scripts/prepare-mobile.mjs && npx cap sync android && npx cap run android",
    "mobile:run:ios": "npm run build && node scripts/prepare-mobile.mjs && npx cap sync ios && npx cap run ios",
    "postinstall": "node scripts/prepare-mobile.mjs || true"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^6.0.0-alpha.8",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/clipboard": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.1",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/network": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/screen-reader": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/toast": "^6.0.2",
    "@capgo/capacitor-native-biometric": "^6.0.4",
    "firebase": "^11.2.0",
    "framer-motion": "^11.15.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  }
}
