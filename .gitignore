# ── Secrets (NEVER commit) ──────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ── Node / Next.js ──────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Native project symlinks (created at install time; don't commit) ──────
# These exist so Capacitor can find android/ and ios/ next to capacitor.config.ts.
# They are recreated by `npm install` (via postinstall) or manually:
#   cd frontend && ln -sf ../android android && ln -sf ../ios ios
frontend/android
frontend/ios
/node_modules

# ── App data (accounts, usage) ──────────────────────────────────────────
backend/data/

# ── Capacitor / Mobile ───────────────────────────────────────────────────
# Native build outputs (gradle / xcodebuild) — regenerated on every build.
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
android/.idea/
android/*.iml
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/DerivedData/
ios/App/App/app/capacitor.config.swift

# ── Generated Capacitor web assets (regenerated by `npx cap sync`) ────────
# These are COPIES of frontend/out/ made by `cap sync`. NEVER edit manually.
# Workflow: edit frontend/ → npm run build → npx cap sync → assets regenerated.
android/app/src/main/assets/public/
ios/App/App/public/

# Generated Capacitor config files (regenerated from frontend/capacitor.config.ts)
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
ios/App/App/capacitor.config.json
ios/App/App/config.xml

# ── Misc ────────────────────────────────────────────────────────────────
.DS_Store
*.log
.idea/
.vscode/

