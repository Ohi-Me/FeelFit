# ── FeelFit backend environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
# This template was auto-sanitized from the production .env on ZIP packaging.

# REQUIRED — backend will not start without this.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Production CORS — your frontend origin(s), comma-separated, no trailing slash.
# Example: https://feelfit.vercel.app,https://www.feelfit.app
# Leave as * for local development.
ALLOWED_ORIGINS=*

# Set to "production" on your host (disables auto-reload).
ENVIRONMENT=development

# Gemini vision — best accuracy for reading photographed/dense lab reports.
# Free tier: get a key at https://aistudio.google.com/apikey
# When set, image/PDF reports are read by Gemini; otherwise the free OCR+parser runs.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Google Sign-In (real login). Create an OAuth 2.0 Client ID (Web) at
# https://console.cloud.google.com/apis/credentials — same value goes in the
# frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Google Maps Places (premium doctor search — real ratings/reviews/open-now).
# Free OSM search is used as a fallback for everyone else. Get a key at
# https://console.cloud.google.com/google/maps-apis — enable "Places API" +
# "Geocoding API".
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Phone number + OTP sign-in (Firebase Phone Auth). Create a free project at
# https://console.firebase.google.com, enable Authentication > Phone, and put
# the Project ID here. No service-account secret needed — we only verify the
# signed ID token Firebase issues after the user confirms their OTP.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Razorpay (real payments — leave unset for test mode, which grants passes
# instantly with no charge so you can develop/test the full flow). Get keys at
# https://dashboard.razorpay.com/app/keys.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Option A — Resend (recommended, simplest). Free tier, no domain verification
# needed to start (uses their shared sandbox sender). Get a key at
# https://resend.com/api-keys. Once you verify your own domain in Resend,
# set RESEND_FROM to send as your brand, e.g. "FeelFit <noreply@yourdomain.com>".
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM=FeelFit <onboarding@resend.dev>

# ── Optional RAG flags (all default-safe — leave unset unless you want them) ────
# ENABLE_RAG=1        # ground report analysis in retrieved evidence
# RAG_LIVE_MEDS=1     # add live OpenFDA/RxNorm docs to the medication layer
# RAG_EMBEDDER=hashing        # hashing (offline) | sentence-transformers
# RAG_VECTOR_STORE=memory     # memory | qdrant | pgvector
